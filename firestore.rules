rules_version = '2';
// Semua baca/tulis data dilakukan dari server Next.js (firebase-admin), yang tidak terkena rules.
// Jadi akses langsung dari browser ditutup total.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
