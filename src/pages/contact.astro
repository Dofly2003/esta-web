---
import Site from "../layouts/Site.astro";
import ContactForm from "../components/ContactForm.tsx";
import { BRAND } from "@shared/constants";

// Untuk pengunjung tanpa JavaScript: hasil kirim form ditampilkan dari query ?ok= / ?err=
const ok = Astro.url.searchParams.get("ok");
const err = Astro.url.searchParams.get("err");
---

<Site title="Kontak">
  <section class="mx-auto grid max-w-6xl gap-12 px-4 py-16 md:grid-cols-5">
    <div class="md:col-span-2">
      <p class="text-sm font-semibold text-accent-2">Kontak</p>
      <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Mari diskusikan proyek Anda.</h1>
      <p class="mt-4 text-white/60">Isi form, atau hubungi kami langsung. Konsultasi awal gratis dan tanpa komitmen.</p>
      <ul class="mt-10 space-y-5 text-sm">
        <li>
          <p class="text-white/40">Email</p>
          <a href={`mailto:${BRAND.email}`} class="font-semibold hover:text-accent-2">{BRAND.email}</a>
        </li>
        <li>
          <p class="text-white/40">WhatsApp</p>
          <a href={`https://wa.me/${BRAND.whatsapp}`} target="_blank" rel="noreferrer" class="font-semibold hover:text-accent-2">{BRAND.phone}</a>
        </li>
        <li>
          <p class="text-white/40">Lokasi</p>
          <p class="font-semibold">{BRAND.address}</p>
        </li>
      </ul>
    </div>
    <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-6 sm:p-8 md:col-span-3">
      {ok && <p class="mb-4 rounded-xl bg-emerald-500/15 p-3 text-sm text-emerald-300">{ok}</p>}
      {err && <p class="mb-4 rounded-xl bg-rose-500/15 p-3 text-sm text-rose-300">{err}</p>}
      <ContactForm client:load />
    </div>
  </section>
</Site>
