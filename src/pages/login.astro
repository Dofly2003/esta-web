---
// Login tim: memakai sistem desain dashboard (src/styles/dashboard.css) dan tema dashboard
// (Sistem / Gelap / Terang dari localStorage, diterapkan sebelum paint lewat ThemeScript).
// Setelah gagal login, email diisi ulang dari sessionStorage (forms.ts, data-keep; password tidak pernah disimpan).
import Base from "../layouts/Base.astro";
import Brand from "../components/dash/Brand.astro";
import Field from "../components/dash/Field.astro";
import Icon from "../components/dash/Icon.astro";
import Notice from "../components/dash/Notice.astro";
import ThemeScript from "../components/dash/ThemeScript.astro";
import { api } from "../lib/api";
import { AUTH_INFO_ERRS, flashText } from "@shared/messages";
import { isEmail, safeNext } from "@shared/format";

const sp = Astro.url.searchParams;
// tujuan setelah masuk: hanya /dashboard… (dinormalisasi; selain itu ke Ringkasan)
const next = safeNext(sp.get("next")) ?? "/dashboard";

// Sudah login → langsung ke tujuan (next)
try {
  await api(Astro, "/api/me");
  return Astro.redirect(next);
} catch {}

// hanya kode pesan yang dikenal (teks tetap dari shared/messages.ts)
const errCode = sp.get("err") ?? "";
const errText = flashText("err", errCode);
// "silakan masuk" / "sesi berakhir" = info (bukan kesalahan isian): password tidak ditandai salah
const info = errText && AUTH_INFO_ERRS.includes(errCode) ? errText : null;
const err = info ? null : errText;
const errAttrs = err ? { "aria-describedby": "login-err" } : {};
// tanpa JS: email dari redirect gagal login (password tidak pernah dibawa)
const emailParam = sp.get("email") ?? "";
const email = emailParam.length <= 200 && isEmail(emailParam) ? emailParam : "";
// nama halaman tujuan untuk pesan "kembali ke …"
const SECTIONS: [string, string][] = [
  ["/dashboard/projects", "Proyek"],
  ["/dashboard/tasks", "Tugas"],
  ["/dashboard/portfolio", "Portofolio"],
  ["/dashboard/inbox", "Inbox"],
  ["/dashboard/team", "Tim & Akun"],
];
const nextPath = next.split(/[?#]/)[0]!;
const nextLabel = nextPath === "/dashboard" ? null : (SECTIONS.find(([p]) => nextPath.startsWith(p))?.[1] ?? null);
---

<Base title="Masuk" dash>
  <ThemeScript slot="head" />

  <main class="login">
    <div class="login-wrap">
      <p class="login-brand"><Brand size="lg" /></p>

      <section class="panel" aria-labelledby="login-h">
        <div class="panel-head login-head">
          <h1 class="h1" id="login-h">Masuk</h1>
          <p class="t-2">Dashboard tim ESTA: proyek, tugas, dan portofolio.</p>
        </div>
        <form method="post" action="/api/auth/login" class="panel-body" data-keep="login">
          <input type="hidden" name="next" value={next} />
          {
            info && (
              <Notice tone="info" id="login-info" data-flash="info">
                {info}
                {nextLabel && <> Setelah masuk, Anda kembali ke halaman {nextLabel}.</>}
              </Notice>
            )
          }
          <Field id="email" label="Email">
            <input
              id="email"
              name="email"
              type="email"
              required
              autocomplete="username"
              spellcheck="false"
              autocapitalize="none"
              autofocus={!email && !err}
              value={email || undefined}
              class="input"
              {...errAttrs}
            />
          </Field>
          <Field id="password" label="Password">
            <input
              id="password"
              name="password"
              type="password"
              required
              autocomplete="current-password"
              autofocus={!!email || !!err}
              class="input"
              aria-invalid={err ? "true" : undefined}
              {...errAttrs}
            />
          </Field>
          {
            err && (
              <Notice tone="crit" id="login-err" data-flash="err">
                {err}
              </Notice>
            )
          }
          <button type="submit" class="btn-primary login-submit" data-pending-label="Masuk…">Masuk</button>
          <p class="cap">Lupa password? Minta admin tim untuk reset.</p>
        </form>
      </section>

      <p class="login-back">
        <a href="/" class="btn btn-quiet"><Icon name="arrow-l" class="ic-sm" />Kembali ke website</a>
      </p>
    </div>
  </main>
</Base>

<script>
  import { enhance } from "../components/dash/forms";
  enhance();
</script>

<style>
  .login {
    display: grid;
    place-items: center;
    min-height: 100vh;
    min-height: 100dvh;
    padding: var(--s-10) var(--s-4);
  }
  .login-wrap {
    display: flex;
    flex-direction: column;
    gap: var(--s-6);
    width: 100%;
    max-width: 380px;
  }
  .login-brand {
    display: flex;
    justify-content: center;
  }
  /* kartu terlihat juga di tema terang (#ebebeb di putih hampir tak tampak) */
  .login .panel {
    border-color: var(--border-strong);
    box-shadow: var(--shadow-sm);
  }
  .login-head {
    padding-top: var(--s-5);
    padding-bottom: var(--s-4);
  }
  .login-submit {
    width: 100%;
    margin-top: var(--s-1);
  }
  .login-back {
    display: flex;
    justify-content: center;
  }
</style>
