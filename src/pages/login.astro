---
import Base from "../layouts/Base.astro";
import Logo from "../components/Logo.astro";
import PixelCorner from "../components/PixelCorner.astro";
import { api } from "../lib/api";
import { ARROW_PATH, ARROW_VIEWBOX } from "../lib/icons";

// Sudah login → langsung ke dashboard
try {
  await api(Astro, "/api/me");
  return Astro.redirect("/dashboard");
} catch {}

const next = Astro.url.searchParams.get("next") ?? "/dashboard";
const err = Astro.url.searchParams.get("err");
---

<Base title="Login Tim">
  <div class="grid-bg relative isolate grid min-h-screen place-items-center overflow-hidden bg-ink px-4 text-white">
    <PixelCorner corner="tr" class="-z-10" />
    <PixelCorner corner="bl" from="#5ec8f2" to="#5a5fd8" class="-z-10" />
    <div class="relative w-full max-w-sm">
      <div class="mb-8 flex justify-center"><Logo /></div>
      <div class="border border-white/12 bg-ink-2/90 p-6 backdrop-blur">
        <p class="mono-dim text-[11px]">[ Dashboard tim ]</p>
        <h1 class="mt-3 text-2xl tracking-[-0.04em]">Masuk</h1>
        <p class="mt-1 mb-6 text-sm text-white/55">Tracking proyek, tugas, dan portofolio.</p>
        <form method="post" action="/api/auth/login" class="space-y-4">
          <input type="hidden" name="next" value={next} />
          <div>
            <label class="mono mb-2 block text-[11px] text-white/55" for="email">Email</label>
            <input id="email" name="email" type="email" required autocomplete="email" class="input-dark" />
          </div>
          <div>
            <label class="mono mb-2 block text-[11px] text-white/55" for="password">Password</label>
            <input id="password" name="password" type="password" required autocomplete="current-password" class="input-dark" />
          </div>
          {err && <p class="text-sm text-rose-400" role="alert">{err}</p>}
          <button type="submit" class="rbtn w-full">
            <span class="rbtn-icon grad" aria-hidden="true">
              <svg width="14" height="12" viewBox={ARROW_VIEWBOX} shape-rendering="crispEdges"><path d={ARROW_PATH} fill="currentColor"></path></svg>
            </span>
            <span class="rbtn-label flex-1 justify-center">Masuk</span>
          </button>
        </form>
      </div>
      <p class="mono mt-6 text-center text-[11px] text-white/40"><a href="/" class="hover:text-white">◂ Kembali ke website</a></p>
    </div>
  </div>
</Base>
