---
import Site from "../../layouts/Site.astro";
import PortfolioDetail from "../../components/PortfolioDetail.astro";
import { apiOrNull } from "../../lib/api";
import type { PublicPortfolioDetail } from "@shared/types";

const data = await apiOrNull<PublicPortfolioDetail>(
  Astro,
  `/api/public/portfolio/${encodeURIComponent(Astro.params.slug!)}`,
);
if (!data) return Astro.rewrite("/404");
const { item, others } = data;
---

<Site title={item.title} description={item.summary}>
  <PortfolioDetail item={item} others={others} />
</Site>
