---
import Site from "../layouts/Site.astro";
import Heading from "../components/Heading.astro";
import RollButton from "../components/RollButton.astro";
import PixelCorner from "../components/PixelCorner.astro";
---

<Site title="Halaman tidak ditemukan">
  <section data-hero data-section class="grid-bg relative isolate grid min-h-[100svh] place-items-center overflow-hidden">
    <PixelCorner corner="tr" class="-z-10" />
    <PixelCorner corner="bl" from="#5ec8f2" to="#5a5fd8" class="-z-10" />
    <div class="container-x flex flex-col items-center py-32 text-center">
      <Heading
        as="h1"
        size="xl"
        align="center"
        tag="#404"
        lines={[
          { text: "Halaman", font: "sans" },
          { text: "Hilang.", font: "pixel" },
        ]}
      />
      <p data-fade class="mt-10 max-w-sm text-white/70">Mungkin link-nya sudah berubah, atau karya ini belum ditayangkan.</p>
      <div data-fade class="mt-8 flex flex-wrap justify-center gap-4">
        <RollButton href="/" label="Ke beranda" />
        <RollButton href="/portfolio" label="Lihat karya" light />
      </div>
    </div>
  </section>
</Site>
