---
import Site from "../layouts/Site.astro";
---

<Site title="Halaman tidak ditemukan">
  <section class="mx-auto grid min-h-[60vh] max-w-6xl place-items-center px-4 py-24 text-center">
    <div>
      <p class="text-7xl font-extrabold text-accent">404</p>
      <h1 class="mt-4 text-2xl font-bold">Halaman tidak ditemukan</h1>
      <p class="mt-2 text-white/60">Mungkin link-nya sudah berubah atau karya ini belum ditayangkan.</p>
      <div class="mt-8 flex justify-center gap-3">
        <a href="/" class="btn-primary rounded-full px-5 py-2.5">Ke Beranda</a>
        <a href="/portfolio" class="btn rounded-full border border-white/15 px-5 py-2.5 text-white hover:bg-white/5">Lihat Portofolio</a>
      </div>
    </div>
  </section>
</Site>
