---
import Dash from "../../layouts/Dash.astro";
import PageHeader from "../../components/dash/PageHeader.astro";
import TaskCard from "../../components/dash/TaskCard.astro";
import { pill } from "../../components/dash/ui";
import { api } from "../../lib/api";
import { TASK_STATUS } from "@shared/constants";
import type { TaskWithRefs, User } from "@shared/types";

const all = Astro.url.searchParams.get("filter") === "all";
const showDone = Astro.url.searchParams.get("done") === "1";
const { tasks, users } = await api<{ tasks: TaskWithRefs[]; users: User[] }>(
  Astro,
  `/api/tasks?filter=${all ? "all" : "mine"}&done=${showDone ? 1 : 0}`,
);
const link = (f: boolean, d: boolean) => `/dashboard/tasks?${f ? "filter=all&" : ""}${d ? "done=1" : ""}`;
const columns = Object.entries(TASK_STATUS).filter(([k]) => showDone || k !== "DONE");
---

<Dash title="Tugas">
  <PageHeader title="Tugas" subtitle="Todo list lintas proyek, diurutkan berdasarkan deadline." />
  <div class="mb-6 flex flex-wrap gap-2">
    <a href={link(false, showDone)} class={pill(!all)}>Tugas saya</a>
    <a href={link(true, showDone)} class={pill(all)}>Semua tim</a>
    <span class="mx-2 w-px bg-zinc-300"></span>
    <a href={link(all, !showDone)} class={pill(showDone)}>{showDone ? "✓ Termasuk selesai" : "Tampilkan yang selesai"}</a>
  </div>

  {
    tasks.length === 0 ? (
      <p class="rounded-xl border border-dashed border-zinc-300 p-6 text-center text-sm text-zinc-500">
        Tidak ada tugas. Tambahkan tugas dari halaman detail proyek.
      </p>
    ) : (
      <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-4">
        {columns.map(([key, col]) => {
          const list = tasks.filter((t) => t.status === key);
          return (
            <section class="rounded-2xl bg-zinc-100/80 p-3">
              <h3 class="mb-3 flex items-center gap-2 px-1 text-sm font-bold">
                {col.label}
                <span class="rounded-full bg-white px-2 text-xs font-semibold text-zinc-500">{list.length}</span>
              </h3>
              <div class="space-y-2">
                {list.map((t) => <TaskCard task={t} users={users} showProject />)}
                {list.length === 0 && <p class="px-1 py-4 text-center text-xs text-zinc-400">Kosong</p>}
              </div>
            </section>
          );
        })}
      </div>
    )
  }
</Dash>
