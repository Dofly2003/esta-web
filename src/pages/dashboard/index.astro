---
import Dash from "../../layouts/Dash.astro";
import PageHeader from "../../components/dash/PageHeader.astro";
import Badge from "../../components/dash/Badge.astro";
import Progress from "../../components/dash/Progress.astro";
import Avatar from "../../components/dash/Avatar.astro";
import Icon from "../../components/dash/Icon.astro";
import SectionHead from "../../components/dash/SectionHead.astro";
import EmptyState from "../../components/dash/EmptyState.astro";
import Due from "../../components/dash/Due.astro";
import SegFilter from "../../components/dash/SegFilter.astro";
import InquiryList from "../../components/dash/InquiryList.astro";
import { api } from "../../lib/api";
import { APP_TZ, isAdmin, PRIORITY, PROJECT_STATUS, REPLY_WITHIN_HOURS } from "@shared/constants";
import { agoText, fmtDate, hoursSince, isLate } from "@shared/format";
import type { ActiveProject, DashboardSummary } from "@shared/types";

const user = Astro.locals.user!;
const admin = isAdmin(user);
const d = await api<DashboardSummary>(Astro, "/api/dashboard");

const todayLabel = new Intl.DateTimeFormat("id-ID", {
  weekday: "long",
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: APP_TZ,
}).format(new Date());

// cakupan tile deadline: anggota melihat tugasnya sendiri dulu, admin melihat tim (?cakupan= menimpa)
const rawScope = Astro.url.searchParams.get("cakupan");
const scope: "saya" | "tim" = rawScope === "saya" || rawScope === "tim" ? rawScope : admin ? "tim" : "saya";
const mineScope = scope === "saya";
const scopeItems = [
  { href: "/dashboard?cakupan=saya", label: "Tugas saya", current: mineScope },
  { href: "/dashboard?cakupan=tim", label: "Tim", current: !mineScope },
];

// janji website: inquiry dibalas maks. 1×24 jam
const inqLate = d.oldestNewInquiryAt != null && hoursSince(d.oldestNewInquiryAt) >= REPLY_WITHIN_HOURS;
const waitDays = (iso: string) => Math.max(1, Math.floor(hoursSince(iso) / 24));
const reviewDays = d.oldestReviewAt ? Math.floor(hoursSince(d.oldestReviewAt) / 24) : null;

// 4 tile yang bisa ditindaklanjuti; tiap tile membuka daftar yang persis berisi angkanya
type Tile = { label: string; value: number; href: string; meta: string; tone: "crit" | "warn" | "ok" | "neutral"; valueCrit?: boolean };
const overdue = mineScope ? d.myOverdue : d.overdue;
const week = mineScope ? d.myDueThisWeek : d.dueThisWeek;
const today = mineScope ? d.myDueToday : d.dueToday;
const tiles: Tile[] = [
  {
    label: "Lewat deadline",
    value: overdue,
    href: mineScope ? "/dashboard/tasks?due=overdue" : "/dashboard/tasks?filter=all&due=overdue",
    meta: mineScope
      ? overdue > 0
        ? `Perlu ditindaklanjuti · tim: ${d.overdue}`
        : `Tugas Anda sesuai jadwal · tim: ${d.overdue}`
      : overdue > 0
        ? `Perlu ditindaklanjuti · ${d.myOverdue} milik Anda`
        : "Semua sesuai jadwal",
    tone: overdue > 0 ? "crit" : "ok",
    valueCrit: overdue > 0,
  },
  {
    label: "Deadline 7 hari ke depan",
    value: week,
    href: mineScope ? "/dashboard/tasks?due=week" : "/dashboard/tasks?filter=all&due=week",
    meta: today > 0 ? `${today} deadline hari ini` : "Tidak ada yang hari ini",
    tone: today > 0 ? "warn" : "neutral",
  },
  {
    label: "Menunggu review",
    value: d.reviewTasks,
    href: "/dashboard/tasks?filter=all&status=REVIEW",
    meta:
      reviewDays == null
        ? "Tidak ada yang menunggu"
        : reviewDays >= 1
          ? `Tertua ${reviewDays} hari di Review`
          : "Tertua masuk Review hari ini",
    tone: reviewDays == null ? "ok" : reviewDays >= 2 ? "warn" : "neutral",
  },
  {
    label: "Inquiry baru",
    value: d.newInquiries,
    href: "/dashboard/inbox?status=NEW",
    meta:
      d.oldestNewInquiryAt == null
        ? "Semua inquiry sudah ditanggapi"
        : inqLate
          ? `Lewat 1×24 jam · menunggu ${waitDays(d.oldestNewInquiryAt)} hari`
          : `Tertua ${agoText(d.oldestNewInquiryAt)}`,
    tone: d.oldestNewInquiryAt == null ? "ok" : inqLate ? "warn" : "neutral",
  },
];

// alasan "Perlu perhatian" (sama dengan aturan atRisk di server/api.ts)
const dueText = (n: number) => (n === 0 ? "hari ini" : `${n} hari lagi`);
// kolom seimbang (≥1200px): admin dengan banyak proyek berjalan → "Inquiry baru" di bawah daftar proyek
const inqUnderProjects = admin && d.active.length > 3;
const reason = (p: ActiveProject) => {
  if (p.late) return `Lewat deadline${p.daysLeft != null && p.daysLeft < 0 ? ` ${-p.daysLeft} hari` : ""}`;
  if (!p.atRisk) return "Sesuai jadwal";
  const pct = p.totalTasks ? Math.round((p.doneTasks / p.totalTasks) * 100) : null;
  const time = p.elapsed != null ? Math.round(p.elapsed * 100) : null;
  if (pct != null && time != null && pct < time - 15) return `Tertinggal: ${pct}% selesai, waktu ${time}%`;
  if (p.daysLeft != null) {
    if (p.totalTasks === 0) return `Deadline ${dueText(p.daysLeft)}, belum ada tugas`;
    return `Deadline ${dueText(p.daysLeft)}, ${p.totalTasks - p.doneTasks} tugas belum selesai`;
  }
  return "Perlu perhatian";
};
---

<Dash title="Ringkasan">
  {
    admin ? (
      <a slot="actions" href="/dashboard/projects?new=1#proyek-baru" class="btn-primary btn-sm">
        <Icon name="plus" class="ic-sm" />
        Proyek baru
      </a>
    ) : (
      <a slot="actions" href="/dashboard/tasks" class="btn-primary btn-sm">
        <Icon name="check" class="ic-sm" />
        Tugas saya
      </a>
    )
  }

  <PageHeader title={`Halo, ${user.name.split(" ")[0]}`} subtitle={`${todayLabel} (WIB) · ringkasan pekerjaan tim.`} />

  <div class="stack">
    <div class="stat-group">
      <div class="filters">
        <SegFilter label="Cakupan tile deadline" items={scopeItems} />
      </div>
      <section aria-label={`Yang perlu ditindaklanjuti (deadline: ${mineScope ? "tugas saya" : "seluruh tim"})`} class="stats">
        {
          tiles.map((s) => (
            <a href={s.href} class="stat">
              <span class="stat-label">{s.label}</span>
              <span class:list={["stat-value num", s.valueCrit && "v-crit"]}>{s.value}</span>
              <span class="stat-meta">
                {s.tone === "crit" || s.tone === "warn" ? (
                  <Icon name="alert" class:list={["ic-sm", s.tone === "crit" ? "v-crit" : "v-warn"]} />
                ) : (
                  <span class:list={["dot", `tone-${s.tone}`]} aria-hidden="true" />
                )}
                <span>{s.meta}</span>
              </span>
            </a>
          ))
        }
      </section>
      {
        d.unassigned > 0 && (
          <p class="cap overview-line">
            <Icon name="alert" class="ic-sm v-warn" />
            <span>
              <a href="/dashboard/tasks?filter=all&assignee=none" class="link">
                {d.unassigned} tugas tanpa penanggung jawab
              </a>. Tentukan siapa yang mengerjakan.
            </span>
          </p>
        )
      }
    </div>

    <div class:list={["cols", admin ? "cols-admin" : "cols-member"]}>
      {
        /* anggota: pekerjaan sendiri dulu (urutan DOM = urutan tampil, kolom kiri);
           admin: proyek dulu, di layar sempit "Tugas saya" naik ke atas lewat CSS order */
        (admin ? (["proj", "side"] as const) : (["side", "proj"] as const)).map((part) =>
          part === "proj" ? (
            <section class="sec" aria-labelledby="h-proj">
              <SectionHead
                id="h-proj"
                title="Proyek berjalan"
                count={d.activeProjects}
                countSr="proyek"
                href="/dashboard/projects?status=ACTIVE"
                linkLabel="Semua proyek berjalan"
              >
                {d.projectsAtRisk > 0 && (
                  <p class="cap">{d.projectsAtRisk} perlu perhatian (lewat deadline atau tertinggal), diurutkan paling atas.</p>
                )}
              </SectionHead>
              {d.active.length === 0 ? (
                <EmptyState title="Tidak ada proyek berjalan.">
                  {admin && (
                    <a slot="actions" href="/dashboard/projects?new=1#proyek-baru" class="btn btn-sm">
                      <Icon name="plus" class="ic-sm" />
                      Proyek baru
                    </a>
                  )}
                </EmptyState>
              ) : (
                <div class="proj">
                  <div class="proj-h" aria-hidden="true">
                    <span>Proyek</span>
                    <span>Status</span>
                    <span class="r">Progres · waktu</span>
                    <span title="Penanggung jawab">PJ</span>
                    <span />
                  </div>
                  <ul>
                    {d.active.map((p) => (
                      <li>
                        <a href={`/dashboard/projects/${p.id}`} class="proj-row">
                          <span class="proj-name">
                            <b>{p.name}</b>
                            <span class="proj-sub">
                              <span class="ell">{p.client}</span>
                              <span class="vh">, deadline </span>
                              <Due date={p.dueDate} late={p.late} class="num" />
                            </span>
                          </span>
                          <span class="proj-state">
                            <Badge opt={PROJECT_STATUS[p.status]} />
                            <span class:list={["cap", p.late ? "v-crit" : p.atRisk && "v-warn"]}>
                              {p.atRisk && <span class="vh">Perlu perhatian: </span>}
                              {reason(p)}
                            </span>
                          </span>
                          <span class="proj-prog">
                            <Progress done={p.doneTasks} total={p.totalTasks} name={p.name} elapsed={p.elapsed} late={p.late} behind={p.atRisk} />
                            {p.totalTasks > 0 && (
                              <span class="sub num">
                                {p.doneTasks}/{p.totalTasks} tugas
                                {p.elapsed != null && <> · waktu {Math.round(p.elapsed * 100)}%</>}
                              </span>
                            )}
                          </span>
                          <span class="proj-lead">
                            <span class="vh">Penanggung jawab: {p.lead?.name ?? "belum ada"}</span>
                            <Avatar name={p.lead?.name} decorative title={p.lead?.name ?? "Tanpa penanggung jawab"} />
                          </span>
                          <Icon name="chev-r" />
                        </a>
                      </li>
                    ))}
                  </ul>
                </div>
              )}
              {(d.doneWithoutPortfolio > 0 || d.onHoldTasks > 0) && (
                <p class="cap overview-foot">
                  {d.doneWithoutPortfolio > 0 && (
                    <a href="/dashboard/projects?status=DONE&pf=belum" class="link">
                      {d.doneWithoutPortfolio} proyek selesai belum dijadikan portofolio
                    </a>
                  )}
                  {d.onHoldTasks > 0 && (
                    <a href="/dashboard/projects?status=ON_HOLD" class="link">
                      {d.onHoldTasks} tugas di proyek ditunda (tidak dihitung di atas)
                    </a>
                  )}
                </p>
              )}
              {inqUnderProjects && <InquiryList inquiries={d.inquiries} total={d.newInquiries} />}
            </section>
          ) : (
            <div class="right-col">
              <section class="sec" aria-labelledby="h-task">
                <SectionHead
                  id="h-task"
                  title="Tugas saya"
                  count={d.myOpenTasks}
                  countSr="tugas terbuka"
                  href="/dashboard/tasks"
                  linkLabel={d.myOpenTasks > d.myTasks.length ? `Lihat semua (${d.myOpenTasks})` : "Semua tugas"}
                />
                <div class="panel">
                  {d.myTasks.length === 0 ? (
                    <EmptyState compact title="Tidak ada tugas terbuka untuk Anda.">
                      {d.unassigned > 0 && (
                        <a slot="actions" href="/dashboard/tasks?filter=all&assignee=none" class="btn btn-sm">
                          Ambil tugas tanpa PJ<span class="vh"> ({d.unassigned} tugas)</span>
                        </a>
                      )}
                    </EmptyState>
                  ) : (
                    <ul class="rows">
                      {d.myTasks.map((t) => (
                        <li>
                          <a href={`/dashboard/projects/${t.projectId}#task-${t.id}`} class="trow">
                            <span class="trow-title">{t.title}</span>
                            <Badge opt={PRIORITY[t.priority]} />
                            <span class="meta">
                              <span class="ell">{t.projectName}</span>
                              {t.dueDate && <Due date={t.dueDate} late={isLate(t)} class="num" />}
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </section>

              {d.reviewTasks > 0 && (
                <section class="sec" aria-labelledby="h-review">
                  <SectionHead
                    id="h-review"
                    title="Menunggu review"
                    count={d.reviewTasks}
                    countSr="tugas"
                    href="/dashboard/tasks?filter=all&status=REVIEW"
                    linkLabel={d.reviewTasks > d.review.length ? `Lihat semua (${d.reviewTasks})` : "Buka daftar"}
                  >
                    <p class="cap">Paling lama menunggu di atas.</p>
                  </SectionHead>
                  <div class="panel">
                    <ul class="rows">
                      {d.review.map((t) => (
                        <li>
                          <a href={`/dashboard/projects/${t.projectId}#task-${t.id}`} class="trow">
                            <span class="trow-title">{t.title}</span>
                            <span class="cap num" title={fmtDate(t.updatedAt)}>
                              Review {agoText(t.updatedAt)}
                            </span>
                            <span class="meta">
                              <span class="ell">{t.projectName}</span>
                            </span>
                          </a>
                        </li>
                      ))}
                    </ul>
                  </div>
                </section>
              )}

              {!inqUnderProjects && <InquiryList inquiries={d.inquiries} total={d.newInquiries} />}
            </div>
          ),
        )
      }
    </div>
  </div>
</Dash>

<style>
  .overview-foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-1) var(--s-4);
  }
  /* ikon di baris pertama, kalimat membungkus di sampingnya (tanpa pemisah yatim) */
  .overview-line {
    display: flex;
    align-items: flex-start;
    gap: var(--gap-inline);
  }
  .overview-line :global(.ic) {
    margin-top: 1px;
  }
  /* anggota: kolom tugas (kiri, lebih sempit) sebelum proyek */
  @media (min-width: 1200px) {
    .cols-member {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1.6fr);
    }
  }
  /* admin saat kolom ditumpuk (< 1200px): "Tugas saya" sebelum daftar proyek */
  @media (max-width: 1199px) {
    .cols-admin > .right-col {
      order: -1;
    }
  }
  .proj-lead {
    display: flex;
    justify-content: center;
  }
</style>
