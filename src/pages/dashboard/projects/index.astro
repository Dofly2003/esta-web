---
import Dash from "../../../layouts/Dash.astro";
import PageHeader from "../../../components/dash/PageHeader.astro";
import Badge from "../../../components/dash/Badge.astro";
import Progress from "../../../components/dash/Progress.astro";
import Avatar from "../../../components/dash/Avatar.astro";
import ProjectForm from "../../../components/dash/ProjectForm.astro";
import { pill } from "../../../components/dash/ui";
import { api } from "../../../lib/api";
import { PROJECT_STATUS, PROJECT_TYPES } from "@shared/constants";
import { fmtDate, isOverdue, progress } from "@shared/format";
import type { Project, Task, User } from "@shared/types";

const sp = Astro.url.searchParams;
const status = sp.get("status") ?? "";
const type = sp.get("type") ?? "";
const q = sp.get("q") ?? "";
const query = new URLSearchParams({ status, type, q }).toString();
const { projects, users } = await api<{ projects: (Project & { lead: User | null; tasks: Task[] })[]; users: User[] }>(
  Astro,
  `/api/projects?${query}`,
);
---

<Dash title="Proyek">
  <PageHeader title="Proyek" subtitle="Semua proyek website, web app, mobile app, dan desain." />

  <details open={sp.has("new")} class="card mb-6 p-5">
    <summary class="font-semibold text-accent">+ Tambah proyek baru</summary>
    <div class="mt-5"><ProjectForm action="/api/projects" users={users} submitLabel="Buat proyek" /></div>
  </details>

  <div class="mb-4 flex flex-wrap items-center gap-2">
    <a href="/dashboard/projects" class={pill(!status)}>Semua</a>
    {Object.entries(PROJECT_STATUS).map(([k, v]) => <a href={`/dashboard/projects?status=${k}`} class={pill(status === k)}>{v.label}</a>)}
    <form class="ml-auto flex gap-2">
      {status && <input type="hidden" name="status" value={status} />}
      <select name="type" class="input w-auto">
        <option value="">Semua jenis</option>
        {Object.entries(PROJECT_TYPES).map(([k, v]) => <option value={k} selected={type === k}>{v}</option>)}
      </select>
      <input name="q" value={q} placeholder="Cari proyek / klien" class="input w-44" />
      <button class="btn-ghost">Cari</button>
    </form>
  </div>

  {
    projects.length === 0 ? (
      <p class="rounded-xl border border-dashed border-zinc-300 p-6 text-center text-sm text-zinc-500">Belum ada proyek yang cocok.</p>
    ) : (
      <div class="card overflow-x-auto">
        <table class="w-full min-w-[760px] text-sm">
          <thead class="border-b border-zinc-200 text-left text-xs text-zinc-500">
            <tr>
              <th class="px-4 py-3 font-semibold">Proyek</th>
              <th class="px-4 py-3 font-semibold">Jenis</th>
              <th class="px-4 py-3 font-semibold">Status</th>
              <th class="px-4 py-3 font-semibold">PJ</th>
              <th class="px-4 py-3 font-semibold">Deadline</th>
              <th class="w-44 px-4 py-3 font-semibold">Progres</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-zinc-100">
            {projects.map((p) => (
              <tr class="hover:bg-zinc-50">
                <td class="px-4 py-3">
                  <a href={`/dashboard/projects/${p.id}`} class="font-semibold hover:text-accent">{p.name}</a>
                  <p class="text-xs text-zinc-500">{p.client}</p>
                </td>
                <td class="px-4 py-3 text-zinc-600">{PROJECT_TYPES[p.type]}</td>
                <td class="px-4 py-3"><Badge opt={PROJECT_STATUS[p.status]} /></td>
                <td class="px-4 py-3"><Avatar name={p.lead?.name} /></td>
                <td class:list={["px-4 py-3", isOverdue(p.dueDate, p.status === "DONE") ? "font-semibold text-rose-600" : "text-zinc-600"]}>{fmtDate(p.dueDate)}</td>
                <td class="px-4 py-3">
                  <Progress value={progress(p.tasks)} />
                  <p class="mt-0.5 text-[11px] text-zinc-400">{p.tasks.filter((t) => t.status === "DONE").length}/{p.tasks.length} tugas</p>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    )
  }
</Dash>
