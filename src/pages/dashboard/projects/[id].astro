---
import Dash from "../../../layouts/Dash.astro";
import PageHeader from "../../../components/dash/PageHeader.astro";
import Badge from "../../../components/dash/Badge.astro";
import Progress from "../../../components/dash/Progress.astro";
import Person from "../../../components/dash/Person.astro";
import Due from "../../../components/dash/Due.astro";
import Icon from "../../../components/dash/Icon.astro";
import Field from "../../../components/dash/Field.astro";
import ProjectForm from "../../../components/dash/ProjectForm.astro";
import TaskRow from "../../../components/dash/TaskRow.astro";
import SectionHead from "../../../components/dash/SectionHead.astro";
import Disclosure from "../../../components/dash/Disclosure.astro";
import DeleteForm from "../../../components/dash/DeleteForm.astro";
import Options from "../../../components/dash/Options.astro";
import StatusSelect from "../../../components/dash/StatusSelect.astro";
import { confirmAttr, errIn, here, invalid, withLoad } from "../../../components/dash/ui";
import { apiOrNull, withFlash } from "../../../lib/api";
import { isAdmin, MAX_TASK_LINES, PRIORITY, PROJECT_STATUS, PROJECT_TYPES, TASK_STATUS } from "@shared/constants";
import { ERR, type ErrCode } from "@shared/messages";
import { doneCount, elapsed, fmtDate, fmtRupiah, isLate } from "@shared/format";
import type { ProjectDetailResponse } from "@shared/types";

const data = await apiOrNull<ProjectDetailResponse>(Astro, `/api/projects/${encodeURIComponent(Astro.params.id!)}`);
if (!data) return Astro.redirect(withFlash("/dashboard/projects", { err: "project-not-found" }));
const { project, portfolio, users, load } = data;
const admin = isAdmin(Astro.locals.user!);
const done = doneCount(project.tasks);
const late = isLate(project);
// error validasi kembali ke form asalnya: tambah tugas (#tambah) atau edit proyek (#edit); kode yang tampil
// di samping field tidak diulang di flash atas
const ADD_ERRS = ["task-title-required", "task-too-many", "task-date-invalid"] as const;
const EDIT_ERRS = ["project-required", "project-name-required", "project-client-required", "budget-invalid", "project-dates", "date-invalid"] as const;
const addErr = errIn(Astro.url, ADD_ERRS);
const addTitleErr = addErr && addErr !== "task-date-invalid" ? ERR[addErr as ErrCode] : null;
const addDueErr = addErr === "task-date-invalid" ? ERR[addErr] : null;
const editErr = errIn(Astro.url, EDIT_ERRS);
const doneNoPortfolio = project.status === "DONE" && portfolio.length === 0;
---

<Dash title={project.name} trail={[{ label: project.name }]} inlineErrors={[...ADD_ERRS, ...EDIT_ERRS]}>
  {
    portfolio.length > 0 ? (
      <a slot="actions" href={`/dashboard/portfolio/${portfolio[0]!.id}`} class="btn btn-sm">
        <Icon name="grid" class="ic-sm" />
        <span class="hide-sm">Lihat di portofolio</span>
        <span class="only-sm" aria-hidden="true">Portofolio</span>
      </a>
    ) : (
      <form slot="actions" method="post" action={`/api/projects/${project.id}/portfolio`}>
        <button
          type="submit"
          class="btn btn-sm"
          data-pending-label="Membuat…"
          {...confirmAttr(`Buat draf portofolio dari proyek “${project.name}”? Draf belum tampil di website sampai ditayangkan.`)}
        >
          <Icon name="grid" class="ic-sm" />
          <span class="hide-sm">Jadikan portofolio</span>
          <span class="only-sm" aria-hidden="true">Portofolio</span>
        </button>
      </form>
    )
  }

  <PageHeader title={project.name} subtitle={`${project.client} · ${PROJECT_TYPES[project.type]}`} />

  <div class="stack">
    <section aria-label="Ringkasan proyek" class="stats facts">
      <div class="stat">
        <span class="stat-label">Status</span>
        {/* ganti status langsung (tanpa membuka form edit lengkap) */}
        <StatusSelect
          action={`/api/projects/${project.id}/status`}
          back={here(Astro.url)}
          options={PROJECT_STATUS}
          selected={project.status}
          label={`Status proyek ${project.name}`}
          saveSr=" status proyek"
          class="fact-v fact-status"
          selectClass="input-sm"
        />
        {doneNoPortfolio && <p class="cap">Selesai, belum ada di portofolio. Pakai tombol “Jadikan portofolio” di atas.</p>}
      </div>
      <div class="stat">
        <span class="stat-label">Penanggung jawab</span>
        <Person name={project.lead?.name} fallback="Belum ada" class="fact-v" />
      </div>
      <div class="stat">
        <span class="stat-label">Timeline</span>
        <span class="fact-v fact-time num">
          <span>{fmtDate(project.startDate)}</span>
          <Icon name="arrow-r" class="ic-sm t-3" />
          <Due date={project.dueDate} late={late} rel={project.status !== "DONE"} />
        </span>
      </div>
      <div class="stat">
        <span class="stat-label">Nilai proyek</span>
        <span class="fact-v num">{fmtRupiah(project.budget)}</span>
      </div>
      <div class="stat">
        <span class="stat-label">Progres ({done}/{project.tasks.length} tugas)</span>
        <span class="fact-v fact-prog">
          <Progress done={done} total={project.tasks.length} name={project.name} elapsed={project.status === "DONE" ? null : elapsed(project)} late={late} />
        </span>
      </div>
    </section>

    {
      project.description && (
        <section class="sec" aria-labelledby="h-desc">
          <h2 class="h2" id="h-desc">Deskripsi</h2>
          <p class="panel pad desc">{project.description}</p>
        </section>
      )
    }

    <section class="sec" aria-labelledby="h-tasks" id="tugas">
      <SectionHead id="h-tasks" title="Tugas" count={project.tasks.length} countSr="tugas">
        <span class="small t-2 num">{done} dari {project.tasks.length} selesai</span>
      </SectionHead>

      {/* Tambah tugas: Enter = tambah; menempel beberapa baris = satu tugas per baris (satu notifikasi Discord).
          Setelah berhasil, fokus kembali ke judul dan PJ/prioritas/deadline terakhir dipakai lagi (forms.ts). */}
      <form
        method="post"
        action="/api/tasks"
        class="panel pad add-task"
        id="tambah"
        data-keep="add-task"
        data-guard
        data-keep-ok="task-created tasks-created"
        data-keep-fields="assigneeId priority dueDate"
      >
        <input type="hidden" name="projectId" value={project.id} />
        <input type="hidden" name="_back" value={here(Astro.url, "tambah")} />
        <Field id="at-title" label="Tugas baru" required class="at-title" error={addTitleErr}>
          <textarea
            id="at-title"
            name="title"
            required
            rows="1"
            placeholder="mis. Desain halaman beranda"
            class="input at-title-input"
            autocomplete="off"
            data-enter-submit
            data-focus-ok="task-created tasks-created"
            aria-describedby={addTitleErr ? "at-title-err at-title-hint" : "at-title-hint"}
            aria-invalid={addTitleErr ? "true" : undefined}
          ></textarea>
          <p class="cap" id="at-title-hint">Tempel daftar untuk menambah banyak sekaligus: satu baris = satu tugas (maks. {MAX_TASK_LINES}).</p>
        </Field>
        <Field id="at-who" label="Penanggung jawab">
          <select id="at-who" name="assigneeId" class="input">
            <option value="">Tanpa penanggung jawab</option>
            <Options from={withLoad(users, load)} selected={project.leadId} />
          </select>
        </Field>
        <Field id="at-prio" label="Prioritas">
          <select id="at-prio" name="priority" class="input">
            <Options from={PRIORITY} selected="MEDIUM" />
          </select>
        </Field>
        <Field id="at-due" label="Deadline" hint="(opsional)" error={addDueErr}>
          <input id="at-due" name="dueDate" type="date" min="2000-01-01" max="2100-12-31" class="input num" {...invalid("at-due", addDueErr)} />
        </Field>
        <div class="add-task-submit">
          <button type="submit" class="btn-primary">
            <Icon name="plus" class="ic-sm" />
            Tambah
          </button>
        </div>
      </form>

      <div class="panel">
        {
          Object.entries(TASK_STATUS).map(([key, col]) => {
            const list = project.tasks.filter((t) => t.status === key);
            return (
              <section class="tgroup" aria-labelledby={`g-${key}`}>
                <h3 class="tgroup-h" id={`g-${key}`}>
                  <span class:list={["dot", col.cls]} aria-hidden="true" />
                  {col.label}
                  <span class="t-2 num">
                    {list.length}
                    <span class="vh"> tugas</span>
                  </span>
                </h3>
                {list.length > 0 && (
                  <ul class="rows">
                    {list.map((t) => (
                      <TaskRow task={t} users={users} afterDelete="tugas" />
                    ))}
                  </ul>
                )}
              </section>
            );
          })
        }
      </div>
    </section>

    <Disclosure icon="edit" label="Ubah detail proyek" id="edit" open={!!editErr}>
      <div class="pad sep">
        <ProjectForm
          action={`/api/projects/${project.id}`}
          users={users}
          project={project}
          submitLabel="Simpan perubahan"
          idPrefix="edit"
          back={here(Astro.url, "edit")}
          primary={false}
          error={editErr}
        />
      </div>
      {
        admin ? (
          <DeleteForm
            action={`/api/projects/${project.id}/delete`}
            confirm={`Hapus proyek “${project.name}” beserta ${project.tasks.length} tugasnya? Tindakan ini tidak bisa dibatalkan.`}
            label="Hapus proyek"
            class="pad sep danger-zone"
          >
            <div>
              <p class="h3">Hapus proyek</p>
              <p class="cap">Semua tugas di proyek ini ikut terhapus.</p>
            </div>
          </DeleteForm>
        ) : (
          <p class="pad sep cap">Hanya admin yang bisa menghapus proyek.</p>
        )
      }
    </Disclosure>
  </div>
</Dash>

<style>
  /* fakta proyek: varian .stats tanpa tautan */
  .fact-v {
    display: flex;
    align-items: center;
    gap: var(--s-2);
    min-width: 0;
    min-height: var(--hit-sm);
    font-weight: var(--fw-medium);
  }
  .fact-v .link {
    font-weight: var(--fw-regular);
  }
  .fact-prog {
    display: block;
    padding-top: var(--s-1);
  }
  .fact-time {
    flex-wrap: wrap;
    gap: 0 var(--s-1);
    font-size: var(--fs-13);
  }
  /* status proyek (StatusSelect) di fakta: select ringkas selebar isinya */
  .fact-status :global(select) {
    width: auto;
    min-width: 9rem;
  }
  .fact-time > span {
    white-space: nowrap;
  }
  .desc {
    color: var(--text-2);
    white-space: pre-line;
    overflow-wrap: anywhere;
  }
  /* form tambah tugas: grid .add-task di dashboard.css (sama dengan /dashboard/tasks) */
  @media (max-width: 639px) {
    .facts > :last-child {
      grid-column: 1 / -1;
    }
  }
</style>
