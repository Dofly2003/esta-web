---
import Dash from "../../../layouts/Dash.astro";
import PageHeader from "../../../components/dash/PageHeader.astro";
import Badge from "../../../components/dash/Badge.astro";
import Progress from "../../../components/dash/Progress.astro";
import ProjectForm from "../../../components/dash/ProjectForm.astro";
import TaskCard from "../../../components/dash/TaskCard.astro";
import { confirmAttr } from "../../../components/dash/ui";
import { apiOrNull } from "../../../lib/api";
import { PRIORITY, PROJECT_STATUS, PROJECT_TYPES, TASK_STATUS } from "@shared/constants";
import { fmtDate, fmtRupiah, isOverdue, progress } from "@shared/format";
import type { PortfolioItem, ProjectWithRefs, User } from "@shared/types";

const data = await apiOrNull<{ project: ProjectWithRefs; portfolio: PortfolioItem[]; users: User[] }>(
  Astro,
  `/api/projects/${encodeURIComponent(Astro.params.id!)}`,
);
if (!data) return Astro.redirect("/dashboard/projects?err=" + encodeURIComponent("Proyek tidak ditemukan."));
const { project, portfolio, users } = data;
const pct = progress(project.tasks);
const back = Astro.url.pathname;
---

<Dash title={project.name}>
  <a href="/dashboard/projects" class="text-sm text-zinc-500 hover:text-accent">← Semua proyek</a>
  <div class="mt-3">
    <PageHeader title={project.name} subtitle={`${project.client} · ${PROJECT_TYPES[project.type]}`}>
      {
        portfolio.length > 0 ? (
          <a href={`/dashboard/portfolio/${portfolio[0]!.id}`} class="btn-ghost">Lihat di portofolio</a>
        ) : (
          <form method="post" action={`/api/projects/${project.id}/portfolio`}>
            <button class="btn-ghost">+ Jadikan portofolio</button>
          </form>
        )
      }
    </PageHeader>
  </div>

  <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-5">
    <div class="card p-4"><p class="text-xs text-zinc-500">Status</p><div class="mt-2"><Badge opt={PROJECT_STATUS[project.status]} /></div></div>
    <div class="card p-4"><p class="text-xs text-zinc-500">Penanggung jawab</p><p class="mt-1 font-semibold">{project.lead?.name ?? "—"}</p></div>
    <div class="card p-4">
      <p class="text-xs text-zinc-500">Timeline</p>
      <p class="mt-1 text-sm font-semibold">
        {fmtDate(project.startDate)} → <span class:list={[isOverdue(project.dueDate, project.status === "DONE") && "text-rose-600"]}>{fmtDate(project.dueDate)}</span>
      </p>
    </div>
    <div class="card p-4"><p class="text-xs text-zinc-500">Nilai proyek</p><p class="mt-1 font-semibold">{fmtRupiah(project.budget)}</p></div>
    <div class="card p-4"><p class="text-xs text-zinc-500">Progres ({project.tasks.length} tugas)</p><div class="mt-2"><Progress value={pct} /></div></div>
  </div>

  {project.description && <p class="card mt-3 whitespace-pre-line p-4 text-sm text-zinc-600">{project.description}</p>}

  <details class="card mt-3 p-4">
    <summary class="text-sm font-semibold text-zinc-700">✎ Edit detail proyek</summary>
    <div class="mt-4"><ProjectForm action={`/api/projects/${project.id}`} users={users} project={project} submitLabel="Simpan perubahan" /></div>
    <form method="post" action={`/api/projects/${project.id}/delete`} class="mt-4 border-t border-zinc-100 pt-4">
      <button class="btn-danger" {...confirmAttr("Hapus proyek beserta semua tugasnya? Tindakan ini tidak bisa dibatalkan.")}>Hapus proyek</button>
    </form>
  </details>

  <form method="post" action="/api/tasks" class="card mt-8 grid gap-2 p-4 sm:grid-cols-2 lg:grid-cols-[1fr_160px_130px_150px_auto]">
    <input type="hidden" name="projectId" value={project.id} />
    <input type="hidden" name="_back" value={back} />
    <input name="title" required placeholder="Tambah tugas / todo baru…" class="input sm:col-span-2 lg:col-span-1" />
    <select name="assigneeId" class="input" aria-label="Assign ke">
      <option value="">Assign ke…</option>
      {users.map((u) => <option value={u.id}>{u.name}</option>)}
    </select>
    <select name="priority" class="input" aria-label="Prioritas">
      {Object.entries(PRIORITY).map(([k, v]) => <option value={k} selected={k === "MEDIUM"}>{v.label}</option>)}
    </select>
    <input name="dueDate" type="date" class="input" aria-label="Deadline" />
    <button type="submit" class="btn-primary">Tambah</button>
  </form>

  <div class="mt-6 grid gap-4 md:grid-cols-2 xl:grid-cols-4">
    {
      Object.entries(TASK_STATUS).map(([key, col]) => {
        const list = project.tasks.filter((t) => t.status === key);
        return (
          <section class="rounded-2xl bg-zinc-100/80 p-3">
            <h3 class="mb-3 flex items-center gap-2 px-1 text-sm font-bold">
              {col.label}
              <span class="rounded-full bg-white px-2 text-xs font-semibold text-zinc-500">{list.length}</span>
            </h3>
            <div class="space-y-2">
              {list.map((t) => <TaskCard task={t} users={users} />)}
              {list.length === 0 && <p class="px-1 py-4 text-center text-xs text-zinc-400">Kosong</p>}
            </div>
          </section>
        );
      })
    }
  </div>
</Dash>
