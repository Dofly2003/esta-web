---
import Cover from "./Cover.astro";
import type { PortfolioItem } from "@shared/types";

interface Props {
  item: PortfolioItem;
}
const { item } = Astro.props;
---

<a href={`/portfolio/${item.slug}`} class="group block">
  <div class="aspect-[4/3] overflow-hidden rounded-2xl bg-ink-3">
    <Cover item={item} class="transition duration-500 group-hover:scale-105" />
  </div>
  <div class="mt-4 flex items-start justify-between gap-4">
    <div>
      <h3 class="text-lg font-bold text-white group-hover:text-accent-2">{item.title}</h3>
      <p class="text-sm text-white/50">{item.client}</p>
    </div>
    <span class="shrink-0 rounded-full border border-white/15 px-3 py-1 text-xs text-white/70">{item.category}</span>
  </div>
</a>
