---
// Tombol khas: kotak ikon gradasi + label mono. Saat hover, panah bergeser
// keluar-masuk dan huruf label "roll" ke atas satu per satu (GSAP, lihat motion.ts).
interface Props {
  href: string;
  label: string;
  light?: boolean;
  class?: string;
  external?: boolean;
}
import { ARROW_PATH, ARROW_VIEWBOX } from "../lib/icons";

const { href, label, light = false, class: className = "", external = false } = Astro.props;
const chars = [...label];
---

<a
  href={href}
  data-roll-btn
  class:list={["rbtn group", light && "rbtn-light", className]}
  {...external ? { target: "_blank", rel: "noreferrer" } : {}}
>
  <span class="rbtn-icon grad">
    {
      [0, 1].map((i) => (
        <svg data-arrow={i} width="14" height="12" viewBox={ARROW_VIEWBOX} aria-hidden="true" shape-rendering="crispEdges">
          <path d={ARROW_PATH} fill="currentColor" />
        </svg>
      ))
    }
  </span>
  <span class="rbtn-label">
    <span class="sr-only">{label}</span>
    <span class="roll" aria-hidden="true">
      {
        chars.map((c) => (
          <span class="roll-c" aria-hidden="true">
            <span>{c}</span>
            <span>{c}</span>
          </span>
        ))
      }
    </span>
  </span>
</a>
