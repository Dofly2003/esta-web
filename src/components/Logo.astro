---
import Mark from "./Mark.astro";

interface Props {
  href?: string;
  size?: "sm" | "md" | "lg";
  dark?: boolean;
}
const { href = "/", size = "md", dark = true } = Astro.props;
const mark = { sm: 20, md: 24, lg: 40 }[size];
const text = { sm: "text-lg", md: "text-xl", lg: "text-4xl" }[size];
---

<a href={href} class:list={["inline-flex items-center gap-2.5", dark ? "text-white" : "text-ink"]} aria-label="ESTA Studio, ke beranda">
  <Mark size={mark} />
  <span class:list={["font-sans leading-none font-semibold tracking-[-0.06em]", text]}>
    ESTA <span class="font-pixel font-normal tracking-[-0.04em] text-azure">Studio</span>
  </span>
</a>
