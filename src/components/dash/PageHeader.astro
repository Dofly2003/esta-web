---
// Kepala halaman dashboard: h1 + subjudul + slot default (mis. badge status Draf/Tayang) di bawahnya.
// Aksi halaman ada di slot "actions" Dash.astro (top bar).
interface Props {
  title: string;
  subtitle?: string;
  class?: string;
}
const { title, subtitle, class: cls } = Astro.props;
---

<header class:list={["page-head", cls]}>
  <div class="page-head-text">
    <h1 class="h1">{title}</h1>
    {subtitle && <p class="answer">{subtitle}</p>}
    <slot />
  </div>
</header>
