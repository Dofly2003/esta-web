---
import Badge from "./Badge.astro";
import Avatar from "./Avatar.astro";
import { autoSubmit, confirmAttr } from "./ui";
import { PRIORITY, TASK_STATUS } from "@shared/constants";
import { fmtDate, isOverdue } from "@shared/format";
import type { TaskWithRefs, User } from "@shared/types";

interface Props {
  task: TaskWithRefs;
  users: User[];
  showProject?: boolean;
}
const { task, users, showProject = false } = Astro.props;
const done = task.status === "DONE";
const back = Astro.url.pathname + Astro.url.search;
---

<div class="rounded-xl border border-zinc-200 bg-white p-3 shadow-sm">
  {showProject && <a href={`/dashboard/projects/${task.projectId}`} class="mb-1 block text-[11px] font-semibold text-accent">{task.projectName}</a>}
  <p class:list={["text-sm font-medium", done && "text-zinc-400 line-through"]}>{task.title}</p>
  {task.description && <p class="mt-1 line-clamp-2 text-xs text-zinc-500">{task.description}</p>}
  <div class="mt-3 flex flex-wrap items-center gap-2">
    <Badge opt={PRIORITY[task.priority]} />
    {task.dueDate && <span class:list={["text-xs", isOverdue(task.dueDate, done) ? "font-semibold text-rose-600" : "text-zinc-500"]}>📅 {fmtDate(task.dueDate)}</span>}
    <span class="ml-auto"><Avatar name={task.assignee?.name} /></span>
  </div>
  <div class="mt-3 flex items-center gap-2 border-t border-zinc-100 pt-2">
    <form method="post" action={`/api/tasks/${task.id}/status`} class="flex-1">
      <input type="hidden" name="_back" value={back} />
      <select name="status" aria-label="Ubah status" class="w-full rounded-md border-0 bg-zinc-100 px-2 py-1 text-xs" {...autoSubmit}>
        {Object.entries(TASK_STATUS).map(([k, v]) => <option value={k} selected={task.status === k}>{v.label}</option>)}
      </select>
      <noscript><button class="mt-1 text-xs text-accent">Simpan</button></noscript>
    </form>
    <details class="relative">
      <summary class="list-none rounded-md px-2 py-1 text-xs text-zinc-500 hover:bg-zinc-100">Edit</summary>
      <div class="absolute right-0 z-20 mt-1 w-72 rounded-xl border border-zinc-200 bg-white p-3 shadow-xl">
        <form method="post" action={`/api/tasks/${task.id}`} class="space-y-2">
          <input type="hidden" name="_back" value={back} />
          <input name="title" value={task.title} required class="input" />
          <textarea name="description" rows="2" class="input" placeholder="Catatan">{task.description}</textarea>
          <div class="grid grid-cols-2 gap-2">
            <select name="priority" class="input">
              {Object.entries(PRIORITY).map(([k, v]) => <option value={k} selected={task.priority === k}>{v.label}</option>)}
            </select>
            <select name="status" class="input">
              {Object.entries(TASK_STATUS).map(([k, v]) => <option value={k} selected={task.status === k}>{v.label}</option>)}
            </select>
            <select name="assigneeId" class="input">
              <option value="">Belum di-assign</option>
              {users.map((u) => <option value={u.id} selected={task.assigneeId === u.id}>{u.name}</option>)}
            </select>
            <input name="dueDate" type="date" value={task.dueDate ?? ""} class="input" />
          </div>
          <button type="submit" class="btn-primary w-full">Simpan</button>
        </form>
        <form method="post" action={`/api/tasks/${task.id}/delete`} class="mt-2">
          <input type="hidden" name="_back" value={back} />
          <button type="submit" class="btn-danger w-full" {...confirmAttr("Hapus tugas ini?")}>Hapus tugas</button>
        </form>
      </div>
    </details>
  </div>
</div>
