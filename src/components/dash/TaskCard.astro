---
// Kartu tugas untuk papan kanban /dashboard/tasks (render <li class="tcard" id="task-<id>">,
// letakkan di dalam <ul class="tcol-body">). Form status/edit/hapus: TaskActions.
import Badge from "./Badge.astro";
import Person from "./Person.astro";
import Due from "./Due.astro";
import TaskActions from "./TaskActions.astro";
import { PRIORITY } from "@shared/constants";
import { isDone, isLate } from "@shared/format";
import type { TaskWithRefs } from "@shared/types";

interface Props {
  task: TaskWithRefs;
}
const { task: t } = Astro.props;
// judul & nama proyek menuju baris tugas ini di detail proyek
const inProject = `/dashboard/projects/${t.projectId}#task-${t.id}`;
---

<li class="tcard" id={`task-${t.id}`} data-row tabindex="-1">
  <a href={`/dashboard/projects/${t.projectId}`} class="tcard-proj link-plain cap ell">{t.projectName}</a>
  <p class:list={["task-title", isDone(t) && "is-done"]}>
    <a href={inProject} class="link-plain">{t.title}<span class="vh"> (buka di proyek {t.projectName})</span></a>
  </p>
  {t.description && <p class="cap line-clamp-2">{t.description}</p>}
  <div class="tcard-meta">
    <Badge opt={PRIORITY[t.priority]} />
    {t.dueDate && <Due date={t.dueDate} late={isLate(t)} class="task-due cap num" quietClass="t-2" icon />}
  </div>
  {/* kaki kartu: penanggung jawab selalu di kiri baris aksi (posisi sama di semua kartu) */}
  <TaskActions task={t} variant="card" pin>
    <span slot="lead" class="tcard-who small">
      <span class="vh">Penanggung jawab: </span>
      <Person
        name={t.assignee?.name}
        fallback="Tanpa PJ"
        title={t.assignee?.name ? undefined : "Tanpa penanggung jawab"}
        nameClass="ell t-2"
      />
    </span>
  </TaskActions>
</li>
