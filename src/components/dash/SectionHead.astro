---
// Kepala section: h2 + hitungan, opsional tautan kecil di kanan; slot default = isi kanan lainnya.
// Letakkan di dalam <section class="sec" aria-labelledby={id}>.
interface Props {
  id: string;
  title: string;
  count?: number;
  /** teks pembaca layar di belakang hitungan, mis. "tugas" */
  countSr?: string;
  href?: string;
  linkLabel?: string;
  class?: string;
}
const { id, title, count, countSr, href, linkLabel, class: cls } = Astro.props;
---

<div class:list={["sec-head", cls]}>
  <h2 class="h2" id={id}>
    {title}
    {
      count != null && (
        <>
        {" "}
        <span class="t-2 num">
          {count}
          {countSr && <span class="vh"> {countSr}</span>}
        </span>
        </>
      )
    }
  </h2>
  {href && <a href={href} class="link small">{linkLabel}</a>}
  <slot />
</div>
