---
// Lingkaran inisial (.avatar, 24px; size="lg" → 32px).
// Tanpa nama: lingkaran putus-putus dengan ikon orang 12px (bukan "?", yang terbaca seperti bantuan) + tooltip emptyTitle. decorative → aria-hidden, tanpa tooltip
// (pakai bila nama sudah tertulis di sebelahnya, mis. di Person). Atribut lain diteruskan ke <span>.
import Icon from "./Icon.astro";
import { initials } from "@shared/format";

interface Props {
  name?: string | null;
  size?: "md" | "lg";
  class?: string;
  emptyTitle?: string;
  decorative?: boolean;
  [attr: string]: unknown;
}
const { name, size = "md", class: cls, emptyTitle = "Tanpa penanggung jawab", decorative = false, ...attrs } = Astro.props;
const classes = ["avatar", size === "lg" && "avatar-lg", !name && "is-empty", cls];
---

{
  decorative ? (
    <span class:list={classes} aria-hidden="true" {...attrs}>
      {name ? initials(name) : <Icon name="users" />}
    </span>
  ) : name ? (
    <span title={name} class:list={classes} {...attrs}>
      {initials(name)}
    </span>
  ) : (
    <span class:list={classes} title={emptyTitle} role="img" aria-label={emptyTitle} {...attrs}>
      <Icon name="users" />
    </span>
  )
}
