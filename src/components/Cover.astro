---
import type { PortfolioItem } from "@shared/types";

interface Props {
  item: Pick<PortfolioItem, "title" | "coverColor" | "imageUrl">;
  class?: string;
}
const { item, class: className = "" } = Astro.props;
const bg = `linear-gradient(140deg, ${item.coverColor} 0%, #10153a 115%)`;
---

{
  item.imageUrl ? (
    <img src={item.imageUrl} alt={item.title} width="1600" height="1200" loading="lazy" decoding="async" class={`h-full w-full object-cover ${className}`} />
  ) : (
    <div class={`relative flex h-full w-full items-end overflow-hidden p-6 ${className}`} style={{ background: bg }}>
      <div class="grid-bg absolute inset-0 opacity-60" />
      <svg class="absolute top-0 right-0 h-1/2 w-auto opacity-90" viewBox="0 0 120 120" aria-hidden="true">
        <path d="M40 0H120V120H100V80H80V40H40Z" fill="rgb(255 255 255 / 0.14)" />
      </svg>
      <span class="relative bg-white px-2 font-pixel text-3xl leading-none tracking-[-0.04em] text-ink">
        {item.title}
      </span>
    </div>
  )
}
