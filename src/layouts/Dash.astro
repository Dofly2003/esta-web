---
import Base from "./Base.astro";
import Logo from "../components/Logo.astro";
import { api } from "../lib/api";
import { initials } from "@shared/format";
import { ROLES } from "@shared/constants";

interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user!;
const { newInquiries } = await api<{ newInquiries: number }>(Astro, "/api/nav");
const path = Astro.url.pathname;
const ok = Astro.url.searchParams.get("ok");
const err = Astro.url.searchParams.get("err");

const links = [
  { href: "/dashboard", label: "Ringkasan", icon: "▦" },
  { href: "/dashboard/projects", label: "Proyek", icon: "◧" },
  { href: "/dashboard/tasks", label: "Tugas", icon: "☑" },
  { href: "/dashboard/portfolio", label: "Portofolio", icon: "◈" },
  { href: "/dashboard/inbox", label: "Inbox", icon: "✉", badge: newInquiries },
  { href: "/dashboard/team", label: "Tim & Akun", icon: "◎" },
];
const active = (href: string) => (href === "/dashboard" ? path === href : path.startsWith(href));
---

<Base title={title}>
  <div class="min-h-screen bg-zinc-50 text-zinc-900 lg:flex">
    <aside class="border-b border-zinc-200 bg-white lg:sticky lg:top-0 lg:flex lg:h-screen lg:w-60 lg:shrink-0 lg:flex-col lg:border-b-0 lg:border-r">
      <div class="flex items-center justify-between px-4 py-4 lg:px-5 lg:py-6">
        <Logo href="/dashboard" size="sm" dark={false} />
        <a href="/" target="_blank" class="text-xs text-zinc-500 hover:text-accent lg:hidden">Lihat web ↗</a>
      </div>
      <nav class="flex gap-1 overflow-x-auto px-3 pb-3 lg:flex-col lg:overflow-visible lg:pb-0">
        {
          links.map((l) => (
            <a
              href={l.href}
              class:list={[
                "flex shrink-0 items-center gap-3 rounded-lg px-3 py-2 text-sm font-medium transition",
                active(l.href) ? "bg-accent/10 text-accent" : "text-zinc-600 hover:bg-zinc-100",
              ]}
            >
              <span class="w-4 text-center opacity-70">{l.icon}</span>
              {l.label}
              {!!l.badge && <span class="ml-auto rounded-full bg-accent px-1.5 text-[10px] font-bold text-white">{l.badge}</span>}
            </a>
          ))
        }
      </nav>
      <div class="hidden border-t border-zinc-200 p-4 lg:mt-auto lg:block">
        <a href="/" target="_blank" class="mb-4 block text-xs text-zinc-500 hover:text-accent">Lihat website publik ↗</a>
        <div class="flex items-center gap-3">
          <span class="grid h-9 w-9 place-items-center rounded-full bg-accent/10 text-xs font-bold text-accent">{initials(user.name)}</span>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold">{user.name}</p>
            <p class="text-xs text-zinc-500">{ROLES[user.role]}</p>
          </div>
        </div>
        <form method="post" action="/api/auth/logout" class="mt-3">
          <button class="w-full rounded-lg px-3 py-2 text-left text-sm text-zinc-500 hover:bg-zinc-100">Keluar</button>
        </form>
      </div>
    </aside>
    <main class="min-w-0 flex-1 px-4 py-6 sm:px-6 lg:px-10 lg:py-10">
      {ok && <p class="mb-6 rounded-xl border border-emerald-200 bg-emerald-50 px-4 py-3 text-sm text-emerald-800">✓ {ok}</p>}
      {err && <p class="mb-6 rounded-xl border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-700">⚠ {err}</p>}
      <slot />
    </main>
  </div>
</Base>
