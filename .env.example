# Lokasi file database SQLite
DATABASE_PATH="data/esta.sqlite"

# Port server production (bun run start). Saat dev: API 3001, website 4321
PORT=3000

# Lama sesi login (hari)
SESSION_DAYS=7

# Alamat publik website (dipakai untuk link di notifikasi Discord)
# SITE_URL="https://esta.id"

# Cadangan webhook Discord (lebih mudah diatur di Dashboard → Tim & Akun)
# DISCORD_WEBHOOK_URL=""

# Password akun admin@esta.id saat import/seed pertama
SEED_PASSWORD="ganti-password-ini"

# --- Online (Vercel + Turso) ---
# JANGAN isi di .env (nanti dev lokal ikut memakai database online).
# Simpan di file terpisah .env.vercel (sudah di-.gitignore):
# TURSO_DATABASE_URL="libsql://esta-web-xxxx.aws-ap-southeast-1.turso.io"
# TURSO_AUTH_TOKEN="..."
# SITE_URL="https://esta-web.vercel.app"
