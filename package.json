{
  "name": "esta-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --watch server/main.ts",
    "dev:web": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "start": "bun server.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:import": "bun scripts/import-firestore.ts",
    "check": "vp check",
    "typecheck": "vp check --no-fmt",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "bun run test:server && bun run test:web",
    "test:server": "bun --no-env-file scripts/test-server.ts",
    "test:server:once": "bun test --no-env-file",
    "test:web": "vp test run"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "astro": "7.4.13",
    "gsap": "^3.15.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "latest",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.1.0",
    "vite-plus": "1.8.0"
  }
}
