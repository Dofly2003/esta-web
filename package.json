{
  "name": "esta-web",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run scripts/dev.ts",
    "dev:api": "bun --watch server/main.ts",
    "dev:web": "bunx --bun astro dev",
    "build": "bunx --bun astro build",
    "start": "bun server.ts",
    "db:seed": "bun scripts/seed.ts",
    "db:import": "bun scripts/import-firestore.ts",
    "check": "vp check",
    "lint": "vp lint",
    "fmt": "vp fmt",
    "test": "vp test"
  },
  "dependencies": {
    "@astrojs/react": "7.1.9",
    "@libsql/client": "^0.18.0",
    "astro": "7.4.13",
    "gsap": "^3.15.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/bun": "latest",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.6.0",
    "vite-plus": "1.7.0"
  }
}
